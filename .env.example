# Change these before sharing the service.
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_ENV=development
ADMIN_KEY=local-admin-key-change-me
DEFAULT_CLIENT_KEY=local-client-key-change-me
DATABASE_PATH=data/attendance.db
# Optional persistent Neon PostgreSQL database. When set, this overrides DATABASE_PATH.
# NEON_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
MODEL_DIR=models
HOSTED_ORIGIN=http://localhost:8000
SESSION_TTL_SECONDS=300
MATCH_THRESHOLD=0.78
MATCH_MARGIN=0.04

